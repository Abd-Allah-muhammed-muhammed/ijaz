APP_NAME=Ijaz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ijaz.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ================================================
# Database
# ================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ijaz
# DB_USERNAME=root
# DB_PASSWORD=

# ================================================
# Monitoring Database
# ================================================
# DB_MONITORING_DRIVER=mysql
# DB_MONITORING_HOST=127.0.0.1
# DB_MONITORING_PORT=3306
DB_MONITORING_DATABASE=ijaz_monitoring
# DB_MONITORING_USERNAME=root
# DB_MONITORING_PASSWORD=
# Optional overrides (default to the values above / main DB_*):
# PULSE_DB_CONNECTION=monitoring
# TELESCOPE_DB_CONNECTION=monitoring
# Pulse Livewire card cache uses a cache STORE name (default = CACHE_STORE), not the monitoring DB:
# PULSE_CACHE_DRIVER=

# ================================================
# Session
# ================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public

# ================================================
# Queue
# ================================================
# Default remains `database` (opt-in). Set to `redis` only when Redis + Horizon workers are ready.
QUEUE_CONNECTION=database

# Spatie MediaLibrary WebP conversions (PerformConversionsJob)
MEDIA_QUEUE=media-conversions

# ================================================
# Cache
# ================================================
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ================================================
# Redis
# ================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis logical DBs (same Redis instance, isolated keyspaces):
# REDIS_DB=0          — general / Horizon meta (`config/horizon.php` → `use` = default)
# REDIS_CACHE_DB=1    — application cache store
# REDIS_QUEUE_DB=2    — queue jobs (Horizon / redis queue driver)
# REDIS_QUEUE_CONNECTION=queue

# ================================================
# Mail
# ================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME="X"
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ================================================
# AWS
# ================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ================================================
# Reverb
# ================================================
# LOCAL (Laragon): plain ws on localhost — VITE_* may mirror REVERB_* below.
# PRODUCTION (ijaz.sa behind Cloudflare): split internal vs public ports:
#   REVERB_SERVER_PORT / REVERB_PORT = internal bind + PHP→Reverb (e.g. 6002)
#   VITE_REVERB_HOST / VITE_REVERB_PORT / VITE_REVERB_SCHEME = browser → Nginx
# Cloudflare only upgrades WebSockets on supported ports (443, 2052–2087,
# 2095–2096, 8443, …) — NOT 8080. This project’s public WS port is 8443
# (Nginx listen 8443 ssl → proxy_pass http://127.0.0.1:6002/app).
# Using 8080 makes TCP/TLS succeed via Cloudflare but the WS upgrade is
# silently dropped (browser: generic wss connection failure).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_PORT=8082

# ================================================
# Vite
# ================================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_BASE_LAYOUT_CONFIG_KEY='metronic-react-demo1-8150'

VITE_APP_VERSION=v8.2.9
VITE_APP_THEME_NAME=Metornic
VITE_APP_THEME_DEMO=demo1

VITE_APP_SASS_PATH=/resources/js/_metronic/assets/sass/core/components
VITE_APP_SASS_VARIABLES_PATH=/resources/js/_metronic/assets/sass/core/components/_variables.scss

# BUILD-TIME: Vite reads these from `.env` during `npm run build` and inlines
# them into the JS bundle. Runtime PHP env alone does NOT update an existing
# public/build. After changing any VITE_REVERB_*, re-run `npm run build`.
#
# Local: mirroring REVERB_* is fine. Production: set VITE_REVERB_* explicitly —
# do NOT mirror REVERB_PORT (internal 6002) into VITE_REVERB_PORT (public 8443).
# Production example:
#   VITE_REVERB_HOST="ijaz.sa"
#   VITE_REVERB_PORT="8443"
#   VITE_REVERB_SCHEME="wss"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_URL="${APP_URL}"

# ================================================
# Pulse & Telescope
# ================================================
PULSE_ENABLED=true
TELESCOPE_ENABLED=false

# ================================================
# Payment
# ================================================
PAYMENT_DRIVER=rajhi

# PayTabs
PAYTABS_MODE=test
PAYTABS_TEST_PROFILE_ID=
PAYTABS_TEST_SERVER_KEY=
PAYTABS_TEST_CLIENT_KEY=
PAYTABS_TEST_CURRENCY=SAR
PAYTABS_TEST_REGION=SAU
PAYTABS_LIVE_PROFILE_ID=
PAYTABS_LIVE_SERVER_KEY=
PAYTABS_LIVE_CLIENT_KEY=
PAYTABS_LIVE_CURRENCY=SAR
PAYTABS_LIVE_REGION=SAU

# Al Rajhi Bank (via Neoleap)
RAJHI_MODE=test
RAJHI_TEST_TRANPORTAL_ID=
RAJHI_TEST_TRANPORTAL_PASSWORD=
RAJHI_TEST_RESOURCE_KEY=
RAJHI_TEST_CURRENCY=682
RAJHI_TEST_ENCRYPTION_IV=PGKEYENCDECIVSPC
RAJHI_LIVE_TRANPORTAL_ID=
RAJHI_LIVE_TRANPORTAL_PASSWORD=
RAJHI_LIVE_RESOURCE_KEY=
RAJHI_LIVE_CURRENCY=682
RAJHI_LIVE_ENCRYPTION_IV=PGKEYENCDECIVSPC

# ================================================
# Firebase Configuration
# ================================================
# Absolute or relative path to the Google service-account JSON.
# Default (when empty): storage/app/firebase/ijaz.json
# Place the real file there locally and on production — never commit it.
FIREBASE_AUTH_FILE_PATH=
# Optional override for the OAuth access-token cache key
FIREBASE_CACHE_KEY=

# Public Web app config (Firebase Console → Project settings → Your apps).
# Source values; mirrored into VITE_* below for the browser bundle.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Web Push *public* certificate only (Cloud Messaging → Web Push certificates).
# Never put a VAPID private key here or in any VITE_* variable.
FIREBASE_VAPID_KEY=

# ================================================
# Firebase Web Push (Provider dashboard browser FCM)
# ================================================
# BUILD-TIME: Vite inlines these into the JS bundle. After changing values,
# re-run `npm run build`. The messaging SW fetches the same public config from
# /firebase-web-config at runtime (no SW rebuild required).
VITE_FIREBASE_API_KEY="${FIREBASE_API_KEY}"
VITE_FIREBASE_AUTH_DOMAIN="${FIREBASE_AUTH_DOMAIN}"
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_MESSAGING_SENDER_ID="${FIREBASE_MESSAGING_SENDER_ID}"
VITE_FIREBASE_APP_ID="${FIREBASE_APP_ID}"
VITE_FIREBASE_VAPID_KEY="${FIREBASE_VAPID_KEY}"

# ================================================
# SMS
# ================================================
SMS_DRIVER=

# Test Number
SMS_TEST_NUMBER=

# Verification Code
SMS_VERIFICATION_CODE=
SMS_VERIFICATION_CODE_ALL_NUMBERS=
OTP_SEND_COOLDOWN_SECONDS=60

# Authentica
SMS_AUTHENTICA_API_KEY=
SMS_AUTHENTICA_TEMPLATE_ID=
SMS_AUTHENTICA_APP_NAME=

# Orbit
SMS_ORBIT_API_TOKEN=
SMS_ORBIT_SENDER_NAME=
SMS_ORBIT_ENDPOINT=https://app.mobile.net.sa
